rule RERUN_CMAKE
  command = /home/liiing/.local/lib/python3.14/site-packages/cmake/data/bin/cmake --regenerate-during-build -S/home/liiing/feedback/uid32360 -B/home/liiing/feedback/uid32360/build-asan
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /home/liiing/.local/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /home/liiing/.local/bin/ninja -t targets
  description = All primary targets available:

